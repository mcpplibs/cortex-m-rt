# {{project.name}} — firmware for a Cortex-M part.
[package]
name    = "{{project.name}}"
version = "0.1.0"

[build]
# THE TRIPLE IS THE ONE LINE TO CHANGE FOR ANOTHER PART. mcpp's target table
# has seven M-profile rows, and they produce incompatible objects: `thumbv7em`
# uses instructions a Cortex-M0 does not have. Picking the row is picking the
# part.
target  = "thumbv7m-none-eabi"
sources = ["src/main.cpp"]

# The zero-libc tier: this program is the whole of its own environment. Nothing
# here calls `printf`, and nothing links a C library.
[target.thumbv7m-none-eabi]
sysroot = ""

# NO `[dependencies]` LINE FOR THE BOARD ITSELF. `mcpp new --template` injects
# the template's own package as a dependency at the version it scaffolded from,
# which is the version that actually has this template — writing it here as well
# would name the package twice, and pin it to whatever this file happened to say.

# ONE LINE IS WHAT MOVING TO HARDWARE COSTS.
#
#     mcpp run                        # the emulator
#     mcpp run --features hardware    # the board, over a debug probe
#     mcpp run --features libc        # with a C library
#
# Same command, same source, same manifest. A project that has moved to hardware
# for good says so on the dependency instead and stops installing an emulator:
#
#     [dependencies]
#     cortex-m-rt = { version = "{{self.version}}", default-features = false,
#                     features = ["hardware"] }
# THE FORWARD TOKEN CARRIES THE NAMESPACE, BECAUSE THE DEPENDENCY DOES.
#
# `mcpp new --template` injects the board as `mcpplibs.cortex-m-rt`, and a
# forward names the dependency by the SAME key. Writing the short name produces
#
#     warning: feature 'hardware' forwards to dependency 'cortex-m-rt' which is
#              not declared in [dependencies] or [feature-deps]
#
# and then does nothing — a warning, not an error, so the flag is accepted and
# silently has no effect. Found in a sandbox, where the package resolves under
# its published identity rather than a local path.
[features]
hardware = { forward = ["mcpplibs.cortex-m-rt/hardware"] }
libc     = { forward = ["mcpplibs.cortex-m-rt/libc"] }
